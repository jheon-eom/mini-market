#    command: redis-server --appendonly yes
#    healthcheck:
#      test: ["CMD", "redis-cli", "ping"]
#      interval: 10s
#      timeout: 5s
#      retries: 5

volumes:
  order-db-data:
    driver: local
#  order-redis-data:
#    driver: local

networks:
  mini-market-network:
    driver: bridge